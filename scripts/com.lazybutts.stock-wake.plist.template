<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.lazybutts.stock-wake</string>
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string>
    <string>__REPO_DIR__/scripts/stock-wake.sh</string>
  </array>
  <key>StartCalendarInterval</key><array>
    <dict><key>Weekday</key><integer>6</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>25</integer></dict>
    <dict><key>Day</key><integer>1</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>55</integer></dict>
  </array>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/stock-wake.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/stock-wake.log</string>
</dict></plist>
