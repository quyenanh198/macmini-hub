{
	admin off
}

# NOTE: every host route must live in a `handle` block. Caddy evaluates the
# `handle` group before bare `route` directives, and the no-matcher fallback
# `handle` is part of that group — a sablier route left at top level is
# unreachable (the fallback wins first). Inside `handle`, the explicit `route`
# wrapper keeps sablier ordered before reverse_proxy.

:80 {
	@home host lazybutts.com
	handle @home {
		reverse_proxy hub-ui:8090
	}

	@chat host chat.lazybutts.com
	handle @chat {
		reverse_proxy chat:8082
	}

	@tts host tts.lazybutts.com
	handle @tts {
		route {
			sablier http://sablier:10000 {
				group tts
				session_duration 15m
				dynamic
			}
			reverse_proxy tts-studio:8000
		}
	}

	@cadence host cadence.lazybutts.com
	handle @cadence {
		route {
			sablier http://sablier:10000 {
				group cadence
				session_duration 15m
				dynamic
			}
			reverse_proxy cadence2:3000
		}
	}

	@stock host stock.lazybutts.com
	handle @stock {
		route {
			sablier http://sablier:10000 {
				group stock
				session_duration 15m
				dynamic
			}
			reverse_proxy stock-site:8080
		}
	}

	handle {
		respond "macmini-hub proxy" 200
	}
}
