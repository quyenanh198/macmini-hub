{
	admin off
}

# NOTE: every host route must live in a `handle` block. Caddy evaluates the
# `handle` group before bare `route` directives, and the no-matcher fallback
# `handle` is part of that group — a sablier route left at top level is
# unreachable (the fallback wins first). Inside `handle`, the explicit `route`
# wrapper keeps sablier ordered before reverse_proxy.

:80 {
	@home host lazybutts.com
	handle @home {
		reverse_proxy hub-ui:8090
	}

	@chat host chat.lazybutts.com
	handle @chat {
		# Nông trại vui vẻ: game sống ở /farm/* cùng host để dùng chung
		# cookie đăng nhập của Chat; container ngủ khi không ai chơi.
		@farm path /farm /farm/*
		route @farm {
			# Lưu ý cache: trang chờ của sablier không mang Cache-Control và
			# plugin ghi response vòng qua middleware `header` của caddy, nên
			# không ép no-store cho nó được. May là vô hại: URL asset luôn
			# versioned (?v=<boot>) và chỉ lộ ra từ index.html — thứ chỉ được
			# serve khi farm đã sống — nên Cloudflare không bao giờ gặp trang
			# chờ ở một URL asset thật. (Đừng curl tay asset lúc farm ngủ.)
			sablier http://sablier:10000 {
				group farm
				# `blocking` thay vì `dynamic` (giống mahjong/blockpuzzle): lúc container
				# restart/deploy, request chờ chứ không trả trang chờ HTML — Cloudflare từng
				# cache trang chờ vào URL ảnh (assets/art/tree.png) suốt 4 tiếng → ảnh vỡ.
				session_duration 45m
				blocking {
					timeout 1m
				}
			}
			reverse_proxy farm:8090
		}
		# VMahjong: game tĩnh, cùng công thức ngủ/thức như farm.
		@mahjong path /mahjong /mahjong/*
		route @mahjong {
			# `blocking` thay vì `dynamic`: giữ request tới khi container thức
			# rồi proxy thẳng, KHÔNG bao giờ trả trang chờ. Game này có URL asset
			# thật không versioned (sw.js, manifest…) — trang chờ lọt vào đó là
			# Cloudflare cache HTML thay JS suốt 4 tiếng (header caddy không đè
			# được response của plugin). Container nginx tĩnh thức trong vài giây.
			sablier http://sablier:10000 {
				group mahjong
				session_duration 15m
				blocking {
					timeout 1m
				}
			}
			reverse_proxy mahjong:8080
		}
		# Xếp Gạch: game tĩnh, cùng công thức.
		@blockpuzzle path /blockpuzzle /blockpuzzle/*
		route @blockpuzzle {
			# `blocking` thay vì `dynamic`: giữ request tới khi container thức
			# rồi proxy thẳng, KHÔNG bao giờ trả trang chờ. Game này có URL asset
			# thật không versioned (sw.js, manifest…) — trang chờ lọt vào đó là
			# Cloudflare cache HTML thay JS suốt 4 tiếng (header caddy không đè
			# được response của plugin). Container nginx tĩnh thức trong vài giây.
			sablier http://sablier:10000 {
				group blockpuzzle
				session_duration 15m
				blocking {
					timeout 1m
				}
			}
			reverse_proxy blockpuzzle:8080
		}
		# Gunny: game bắn nhau sống ở /gunny/* cùng host để mượn cookie đăng nhập
		# `lb_session` của Chat — server Gunny hỏi Chat /api/me xem ai đang chơi, không
		# có secret dùng chung. handle_path cắt tiền tố /gunny nên server Gunny vẫn thấy
		# /api/*, /ws y như lúc chạy ở gunny.lazybutts.com; client dựng URL theo
		# document.baseURI nên chạy đúng ở cả hai chỗ.
		# Không qua sablier (khác ba game trên): giữa trận có thể vài phút không có
		# request HTTP nào, sablier sẽ tưởng rảnh mà tắt container ngay giữa ván.
		redir /gunny /gunny/
		handle_path /gunny/* {
			reverse_proxy gunny:8080
		}
		reverse_proxy chat:8082
	}

	# Musik: trình phát nhạc, luôn chạy (không sablier) để phát nền không bị khựng.
	@musik host musik.lazybutts.com
	handle @musik {
		reverse_proxy musik:3000
	}

	# AudioExtract: tách audio (yt-dlp), luôn chạy như Musik; SSE tiến trình cần
	# flush ngay, không đệm.
	@audioextract host audioextract.lazybutts.com
	handle @audioextract {
		reverse_proxy audioextract:3000 {
			flush_interval -1
		}
	}

	# Gunny: server Node luôn chạy (không sablier — WebSocket /ws giữ trạng thái
	# phòng/trận, sablier có thể ngủ giữa trận). reverse_proxy tự chuyển tiếp
	# WebSocket upgrade, không cần cấu hình thêm.
	@gunny host gunny.lazybutts.com
	handle @gunny {
		reverse_proxy gunny:8080
	}

	@noto host noto.lazybutts.com
	handle @noto {
		route {
			# `blocking` như mahjong/blockpuzzle: giữ request tới khi container
			# thức rồi proxy thẳng, không bao giờ trả trang chờ (Cloudflare từng
			# cache trang chờ vào URL asset và giữ 4 tiếng).
			sablier http://sablier:10000 {
				group noto
				session_duration 15m
				blocking {
					timeout 1m
				}
			}
			reverse_proxy noto:8080
		}
	}

	@tts host tts.lazybutts.com
	handle @tts {
		reverse_proxy host.docker.internal:8600
	}

	@cadence host cadence.lazybutts.com
	handle @cadence {
		route {
			sablier http://sablier:10000 {
				group cadence
				session_duration 15m
				dynamic
			}
			reverse_proxy cadence2:3000
		}
	}

	@stock host stock.lazybutts.com
	handle @stock {
		route {
			sablier http://sablier:10000 {
				group stock
				session_duration 15m
				dynamic
			}
			reverse_proxy stock-site:8080
		}
	}

	handle {
		respond "macmini-hub proxy" 200
	}
}
